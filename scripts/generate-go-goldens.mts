import {createHash} from 'node:crypto'
import {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises'
import {tmpdir} from 'node:os'
import {join,dirname} from 'node:path'
import {fileURLToPath} from 'node:url'
import {rebuildHarnessProjection} from '../apps/api/src/harness/projection.js'
import {noteCreateSchema,noteUpdateSchema} from '../packages/contracts/src/notes.js'
const repo=fileURLToPath(new URL('..',import.meta.url))
const strings=['','ASCII','中文😀e\u0301\r\n\r\n<> &','\t\n\v\f\r \u00a0\u1680\u2000\u200a\u2028\u2029\u202f\u205f\u3000\ufeff\u0085','"\\\b\f\n\r\t\u0000\u001f','U+2028\u2028U+2029\u2029 <>&','高\uD800中\uDC00尾']
const cases=strings.map(input=>({input,utf16Length:input.length,key:Buffer.from(input).toString('base64url'),words:Array.from(input.replace(/\s+/g,'')).length,hash:'sha256:'+createHash('sha256').update(input).digest('hex'),quote:JSON.stringify(input)}))
const files={
 'manuscript/CH-001.md':'# Fixture\r\nID: CH-001\r\norder: 1\r\n\r\n中文😀  \r\n\r\n> quote\r\n- item\r\n',
 'manuscript/CH-02.md':'#\u3000Wide title\nID: CH-02\n\nFixture\n',
 'manuscript/README.md':'# Template\n\nNo stable ID.\n',
 'book/index.md':'# Index\n\nNot canon.\n',
 'book/WORLD-001.md':'# World\nID: WORLD-001\nsource: inbox/a.md#SRC-1； inbox/missing.md; external; see\u00a0inbox/a.md#SRC-2\u00a0text;\nstatus: confirmed（部分）\nrelated: CH-001, INTENT-001, CH-001\n\n## Rule\n\nunknown\n',
 'inbox/a.md':'# Input\n\nUTF-8 source.\n',
 'proposals/P-001.md':'# Candidate\n\nCandidate text only.\n',
 'proposals/P-001-copy.md':'# Duplicate\nID: P-001\n\nNever select a winner.\n'
}
const binaryFiles={'inbox/bytes.md':Buffer.from([0xff,0xff,0xc2,0x41,0xe1,0x80,0x41]).toString('base64')}
const temp=await mkdtemp(join(tmpdir(),'writer-goldens-'))
try{for(const [path,content]of Object.entries(files)){await mkdir(dirname(join(temp,path)),{recursive:true});await writeFile(join(temp,path),content)}
 for(const [path,data]of Object.entries(binaryFiles))await writeFile(join(temp,path),Buffer.from(data,'base64'))
 const fingerprints=[noteCreateSchema.parse({content:'<>&😀\u2028\u2029'}),noteUpdateSchema.parse({content:'updated',chapterId:'CH-001',purpose:'next_writing',baseVersion:2,status:'archived'})].map((input,index)=>({noteId:index?'00000000-0000-4000-8000-000000000001':null,input,value:JSON.stringify([index?'00000000-0000-4000-8000-000000000001':null,input])}))
 const golden={provenance:'Generated by the retained Node API/Zod; do not hand-edit.',cases,files,binaryFiles,projection:await rebuildHarnessProjection(temp,'golden'),fingerprints}
 const path=join(repo,'apps/api-go/internal/testdata/node-golden.json');await mkdir(dirname(path),{recursive:true});await writeFile(path,JSON.stringify(golden,null,2)+'\n')
}finally{await rm(temp,{recursive:true,force:true})}
