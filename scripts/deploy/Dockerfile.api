FROM node:22-alpine

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm@10.15.1

# 复制 workspace 配置
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/

# 仅安装生产依赖（含 devDeps，因为需要 tsx 构建）
RUN pnpm install --frozen-lockfile

# 复制源码
COPY packages ./packages
COPY apps/api ./apps/api

# 构建 contracts + api
RUN pnpm --filter @writer-agent/contracts build && \
    pnpm --filter @writer-agent/api build

# 清理 devDeps，只保留运行时所需
RUN pnpm prune --prod

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8787/health || exit 1

EXPOSE 8787

ENV NODE_ENV=production \
    WRITER_AGENT_API_PORT=8787

CMD ["node", "apps/api/dist/dev-server.js"]
