{
  "name": "ai-write-life-circle",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @writer-agent/web dev",
    "dev:local": "node scripts/dev-local-stack.mjs",
    "build": "pnpm build:api:go && pnpm --filter @writer-agent/web build",
    "typecheck": "pnpm --filter @writer-agent/contracts typecheck && pnpm --filter @writer-agent/api typecheck && pnpm --filter @writer-agent/web typecheck",
    "lint": "pnpm --filter @writer-agent/web lint && ./apps/web/node_modules/.bin/eslint --config apps/web/eslint.config.js apps/api/src apps/api/test packages/contracts/src",
    "test": "pnpm test:api:go && pnpm test:api:node && pnpm --filter @writer-agent/web test",
    "openapi:generate": "pnpm --filter @writer-agent/api exec tsx ../../scripts/build-notes-openapi.mts && node scripts/build-openapi-candidate.mjs",
    "openapi:check": "pnpm --filter @writer-agent/api exec tsx ../../scripts/build-notes-openapi.mts --check && node scripts/build-openapi-candidate.mjs --check",
    "openapi:lint": "pnpm exec redocly lint harness/contracts/api-spec-v0.4.0-proposed.yaml",
    "dev:api": "pnpm dev:api:go",
    "harness:rebuild": "go run -C apps/api-go ./cmd/harness",
    "test:e2e": "pnpm --filter @writer-agent/web test:e2e",
    "dev:api:node": "pnpm --filter @writer-agent/api dev",
    "dev:api:go": "go run -C apps/api-go ./cmd/server",
    "dev:local:go": "node scripts/dev-local-stack.mjs",
    "dev:local:node": "node scripts/dev-local-stack.mjs --node",
    "build:api:go": "go build -C apps/api-go -o dist/writer-agent-api ./cmd/server",
    "build:api:node": "pnpm --filter @writer-agent/api build",
    "test:api:go": "go test -C apps/api-go -race ./...",
    "test:api:node": "pnpm --filter @writer-agent/api test",
    "test:api:parity": "pnpm --filter @writer-agent/contracts build && pnpm --filter @writer-agent/api exec tsx ../../scripts/test-api-parity.mts",
    "harness:rebuild:node": "pnpm --filter @writer-agent/api harness:rebuild",
    "go:goldens": "pnpm --filter @writer-agent/api exec tsx ../../scripts/generate-go-goldens.mts",
    "bench:api": "pnpm build:api:node && pnpm build:api:go && node scripts/benchmark-api.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
